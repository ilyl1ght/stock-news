# ---------------------------------------------------------------------------
# STOCK NEWS - environment configuration
# Copy this file to .env in the project root and fill in your own values.
# .env is gitignored - never commit real secrets.
# ---------------------------------------------------------------------------

# Server port (the single Node process serves both the API and the built
# frontend from this port).
PORT=8080

# --- Market data / news provider (Finnhub) ----------------------------------
# Free API key: https://finnhub.io/register (no credit card required).
# Used for: symbol search, live quotes, company profiles, company news,
# and general market news. Without this key the app still runs, but shows
# "Market data temporarily unavailable" instead of live data.
FINNHUB_API_KEY=

# --- Discord webhook (optional, can also be set from the Settings page) -----
# Create one in Discord: Server Settings -> Integrations -> Webhooks -> New
# Webhook, then "Copy Webhook URL". This value is only ever read on the
# server and is never sent to the browser. If you set it here, it becomes
# the default; saving a new URL from the Settings page overrides it.
DISCORD_WEBHOOK_URL=

# --- Background monitor -------------------------------------------------
# How often (minutes) the server checks watchlist stocks for new news,
# signal changes, and significant price moves.
MONITOR_INTERVAL_MINUTES=5

# Restrict CORS to a specific origin in production (leave blank to allow
# same-origin requests only, which is what you want once the server serves
# the built frontend itself).
CORS_ORIGIN=
